# --- Sarvam (required) ---
SARVAM_API_KEY=

# --- Cashfree sandbox (optional; blank = simulated rails) ---
# Payouts:        Merchant Dashboard > Payouts > Developers > API Keys (test mode)
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
# 2FA: either whitelist your IP, or download the public key and point to it here
CASHFREE_PAYOUTS_PUBLIC_KEY_PATH=
# Secure ID (bank account verification): Developers > Secure ID > API Keys
CASHFREE_VERIFY_CLIENT_ID=
CASHFREE_VERIFY_CLIENT_SECRET=
CASHFREE_VERIFY_PUBLIC_KEY_PATH=
# Payment Gateway (Payment Links): Developers > Payment Gateway > API Keys
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=

# --- Sarvam Voice Agents for real phone calls (optional; blank = browser calls) ---
SARVAM_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# --- App ---
# Your public HTTPS URL (ngrok). Used for Cashfree notify_url and payment link pages.
PUBLIC_URL=http://localhost:8000
OWNER_LANGUAGE=ta-IN
